---
import '../styles/global.css';
import FloatingNavbar from '../components/FloatingNavbar.jsx';
interface Props {
  title?: string;
}
const { title = "Ivan Akbar Alfahrezi" } = Astro.props;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <script is:inline>
      const theme = localStorage.getItem('theme') || 'dark';
      document.documentElement.classList.toggle('dark', theme === 'dark');
    </script>
  </head>
  <body class="pt-24 pb-16 selection:bg-accent/20 selection:text-accent">
    <FloatingNavbar client:load />
    <slot />

    <script is:inline>
      window.addEventListener('langchange', (e) => {
        const lang = e.detail;
        document.querySelectorAll('[data-i18n-key]').forEach(el => {
          // can update dynamic texts if needed
        });
        window.location.reload();
      });
    </script>
  </body>
</html>
