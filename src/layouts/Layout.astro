---
interface Props {
  title?: string;
}

const { title = "Ivan Akbar Alfahrezi — Full-Stack Developer" } = Astro.props;
import Footer from '../components/Footer.jsx';
import FloatingNav from '../components/FloatingNav.jsx';
import '../styles/global.css';
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
  </head>
  <body class="bg-[#faf8f5] dark:bg-[#111110] text-[#111110] dark:text-[#e8e6e1] font-sans antialiased selection:bg-[#c4623a]/20">
    <FloatingNav client:load />
    <slot />
    <Footer client:load />
  </body>
</html>
