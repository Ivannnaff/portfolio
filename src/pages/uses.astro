---
import Layout from '../layouts/Layout.astro';
import { translations } from '../translations';
const t = translations.en;
---

<Layout title="Uses — Ivan Akbar">
  <main class="max-w-2xl mx-auto px-6 py-16">
    <div class="mb-12">
      <h1 class="text-2xl font-medium tracking-tight mb-3">{t.uses.title}</h1>
      <p class="text-[#2a2a27] dark:text-[#999691] leading-relaxed">{t.uses.intro}</p>
    </div>
    <div class="divide-y divide-[#eeecea] dark:divide-[#2a2a27]">
      {t.uses.sections.map((section) => (
        <section class="py-8 grid grid-cols-1 sm:grid-cols-[7rem_1fr] gap-6 items-start">
          <p class="font-mono text-xs text-[#6b6b66] dark:text-[#555451] pt-1">{section.label}</p>
          <ul class="space-y-4">
            {section.items.map((item) => (
              <li>
                <p class="text-sm font-medium text-[#111110] dark:text-[#e8e6e1]">{item.name}</p>
                {item.note && <p class="mt-0.5 text-sm text-[#3a3a36] dark:text-[#4a4a46] leading-relaxed">{item.note}</p>}
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </main>
</Layout>
