---
import Layout from '../layouts/Layout.astro';
import { translations } from '../translations';
const t = translations.en;
---

<Layout title="Ivan Akbar Alfahrezi | Full-Stack web developer">
  <main class="max-w-2xl mx-auto px-6 py-16">
    <h1 class="text-3xl font-semibold tracking-tight mb-3">
      <span class="text-[#c4623a]">Ivan</span> Akbar Alfahrezi
    </h1>
    <p class="text-base text-[#3a3a36] dark:text-[#999691] leading-relaxed mb-6">
      {t.home.bio}
    </p>
    <p class="text-sm text-[#c4623a] font-medium mb-8">
      ● {t.home.availability}
    </p>
    <div class="flex flex-wrap gap-x-6 gap-y-2 text-sm font-medium">
      <a href="https://github.com/Ivannnaff" target="_blank" rel="noreferrer" class="hover:text-[#c4623a] transition-colors">GitHub ↗</a>
      <a href="https://linkedin.com/in/IvanAkbarAlfahrezi" target="_blank" rel="noreferrer" class="hover:text-[#c4623a] transition-colors">LinkedIn ↗</a>
      <a href="mailto:ivanalfa647@gmail.com" class="hover:text-[#c4623a] transition-colors">Email ↗</a>
    </div>
  </main>
</Layout>
